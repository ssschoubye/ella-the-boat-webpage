# Copy this file to .env for local development and fill in real values.
# .env is never committed. In production the same variables come from
# secrets/ella.sops.yaml in the home-server repo (see docs/deployment.md).

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value

DJANGO_TIME_ZONE=Europe/Copenhagen

# --- Sign-on ---
# Google is the only way in (docs/adr/0010-invitation-links-and-google-sign-in.md).
# Create the OAuth client as described in docs/security.md, and add
#   http://localhost:8000
#   http://localhost:8000/accounts/google/login/callback/
# to it so the same client works locally.
#
# The site runs without these, but "Fortsæt med Google" will fail, so set them
# if you are working on anything to do with logging in. To work on something
# else, use `manage.py createsuperuser` and log in at /admin/.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# What invitation links are built from. `manage.py invite` has no request to
# derive a host from, so it has to be told.
DJANGO_PUBLIC_BASE_URL=http://localhost:8000

# How long a new invitation link stays usable.
# DJANGO_INVITATION_VALID_DAYS=30

# --- Sending sign-in codes ---
# The second way in, for anyone without a Google account: a one-time code
# emailed to any address (docs/adr/0013-email-sign-in-codes.md).
#
# Locally you need none of this. The default backend prints the mail to the
# runserver output, so the code is right there in your terminal.
#
# In production these come from secrets/ella.sops.yaml in home-server, where
# the host is Resend's SMTP relay and the password is a Resend API key.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.resend.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=resend
# DJANGO_EMAIL_HOST_PASSWORD=re_xxxxxxxx
# DJANGO_EMAIL_USE_TLS=True
# The sender must be on a domain verified with Resend, or it is rejected.
# DJANGO_DEFAULT_FROM_EMAIL=Ella <noreply@molder.app>

# --- Production only (config.settings.prod) — the defaults are right for the home server ---
# DJANGO_ALLOWED_HOSTS=ella.molder.app,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ella.molder.app
# Where the SQLite database, uploads and backup snapshot live (a bind mount in the container)
# DJANGO_DATA_DIR=/data
# DJANGO_SECURE_SSL_REDIRECT=False
