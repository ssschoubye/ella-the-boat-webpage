# Copy this file to .env and fill in real values.
# .env is only read locally / on the server — never commit the real one.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value

DJANGO_TIME_ZONE=Europe/Copenhagen

# --- Production only (config.settings.prod) ---
# Comma-separated list of domains this site is allowed to serve
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# postgres://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgres://django:changeme@localhost:5432/mysite

DJANGO_SECURE_SSL_REDIRECT=True
