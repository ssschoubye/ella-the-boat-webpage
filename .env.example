# Copy this file to .env for local development and fill in real values.
# .env is never committed. In production the same variables come from
# secrets/ella.sops.yaml in the home-server repo (see docs/deployment.md).

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value

DJANGO_TIME_ZONE=Europe/Copenhagen

# --- Sign-on ---
# There is nothing to configure. An invitation link lets one person create one
# account with any email address and a password of their own choosing, and
# that is the only way in (docs/adr/0014-invite-links-and-passwords.md).
# No identity provider, no SMTP, no secrets beyond the one above.

# What invitation links are built from. `manage.py invite` has no request to
# derive a host from, so it has to be told.
DJANGO_PUBLIC_BASE_URL=http://localhost:8000

# How long a new invitation link stays usable.
# DJANGO_INVITATION_VALID_DAYS=30

# --- Production only (config.settings.prod) — the defaults are right for the home server ---
# DJANGO_ALLOWED_HOSTS=ella.molder.app,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ella.molder.app
# Where the SQLite database, uploads and backup snapshot live (a bind mount in the container)
# DJANGO_DATA_DIR=/data
# DJANGO_SECURE_SSL_REDIRECT=False
